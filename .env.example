# Copy to .env and fill in. Never commit .env (NFR-SEC-02).

ENVIRONMENT=local
DEBUG=true

# Postgres 16 (docker container fmep-pg)
DATABASE_URL=postgresql+psycopg://postgres:devpass@localhost:55432/fmep

# Redis. 6379 is taken by pic-rms-redis on this machine; fmep-redis maps to 6380.
REDIS_URL=redis://localhost:6380/0

# Frontend origins allowed to call this API
CORS_ORIGINS=["http://localhost:3000"]

# Data providers -- server-side only, never in the frontend bundle
API_FOOTBALL_KEY=
ODDS_API_KEY=
APISPORTS_KEY=

# Set these on a deployment and the API refuses anyone without a key.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=["change-me"]
RATE_LIMIT_PER_MINUTE=120
POSTGRES_PASSWORD=change-me
