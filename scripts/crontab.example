# The schedule this project needs on a Linux server. Install with:
#   crontab scripts/crontab.example
# Times are the server's local time, so set the timezone first:
#   sudo timedatectl set-timezone Europe/London
#
# Paths assume the project is at /opt/fmep; change PROJECT if it is elsewhere.
PROJECT=/opt/fmep
SHELL=/bin/bash

# Tuesday 09:00 -- full refresh: results, fixtures, features, forecasts, settlement.
# NOT Monday: football-data.co.uk publishes a round a day or two after it is
# played, so a Monday morning run reads last week's file and quietly does nothing.
0 9 * * 2 cd $PROJECT && scripts/run_weekly.sh

# Thursday 18:00 -- short refresh once weekend referees are named, with market prices
0 18 * * 4 cd $PROJECT && scripts/run_weekly.sh --days-back 3 --days-ahead 4 --with-odds

# Nightly 03:30 -- database backup
30 3 * * * cd $PROJECT && scripts/backup_db.sh >> data/logs/backup.log 2>&1
